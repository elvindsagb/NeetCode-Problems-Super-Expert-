Problem

Implement a DSU that supports:

union(a, b)
find(x)
rollback() to undo the last union
Concepts
Union-Find
Rollback / persistence style logic

--------------------------------------------------------------------------------------------------

class DSURollback:
    def __init__(self, n):
        self.parent = list(range(n))
        self.size = [1] * n
        self.history = []

    def find(self, x):
        while x != self.parent[x]:
            x = self.parent[x]
        return x

    def union(self, a, b):
        a = self.find(a)
        b = self.find(b)

        if a == b:
            self.history.append((-1, -1, -1))
            return False

        if self.size[a] < self.size[b]:
            a, b = b, a

        self.history.append((b, self.parent[b], self.size[a]))

        self.parent[b] = a
        self.size[a] += self.size[b]
        return True

    def rollback(self):
        b, old_parent, old_size_a = self.history.pop()

        if b == -1:
            return

        a = self.parent[b]
        self.parent[b] = old_parent
        self.size[a] = old_size_a


dsu = DSURollback(5)

print(dsu.union(0, 1))
print(dsu.union(1, 2))
print("Find 2:", dsu.find(2))

dsu.rollback()
print("After rollback, Find 2:", dsu.find(2))
